# Postgres connection string used by Prisma and the app.
# Docker Compose (the app talks to the `db` service by name):
DATABASE_URL="postgresql://hoshin:hoshin@db:5432/hoshin?schema=public"
# Running the app outside Compose, against the published port, use this instead:
# DATABASE_URL="postgresql://hoshin:hoshin@localhost:5432/hoshin?schema=public"

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# --------------------------------------------------------- Microsoft SSO
# From the Entra app registration (see README, "Signing in with Microsoft").
# The issuer MUST name your tenant. Left unset it defaults to /common/, which
# would let any Microsoft account in the world - personal Outlook and Xbox
# accounts included - reach the sign-in step.
AUTH_MICROSOFT_ENTRA_ID_ID="<Application (client) ID>"
AUTH_MICROSOFT_ENTRA_ID_SECRET="<Client secret value>"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<Directory (tenant) ID>/v2.0"

# Email and password sign-in is on automatically outside production, so the
# seeded demo accounts work in development. Set this to keep it in production
# as a deliberate break-glass path - otherwise production is SSO only.
# AUTH_ALLOW_PASSWORD=true

# ---------------------------------------------------- Month-end reminders
# Where the "key these figures" link points. Wrong here means every reminder
# sends people to the wrong host, so set it per environment.
APP_URL="http://localhost:3000"

# Shared secret the scheduler presents as `Authorization: Bearer <secret>`
# when calling POST /api/reminders. Generate with: openssl rand -base64 32
# Unset, the endpoint refuses every call rather than running open.
REMINDER_TRIGGER_SECRET="change-me"

# Sending through Microsoft Graph, app-only. GRAPH_TENANT_ID is the same
# Directory (tenant) ID as the issuer above, and the client id is reused from
# the SSO app registration - but the secret is separate so the two can be
# rotated independently. REMINDER_FROM is the mailbox reminders come from;
# it must be a real mailbox in the tenant.
GRAPH_TENANT_ID="<Directory (tenant) ID>"
GRAPH_CLIENT_SECRET="<Client secret value>"
REMINDER_FROM="hoshin-noreply@yourcompany.com"
