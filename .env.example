# Postgres connection string used by Prisma and the app.
# Docker Compose (the app talks to the `db` service by name):
DATABASE_URL="postgresql://hoshin:hoshin@db:5432/hoshin?schema=public"
# Running the app outside Compose, against the published port, use this instead:
# DATABASE_URL="postgresql://hoshin:hoshin@localhost:5432/hoshin?schema=public"

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
