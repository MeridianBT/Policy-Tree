// Hoshin Kanri policy deployment platform.
//
// Design principle: the month is the only grain that is stored. Quarters, Ki
// totals, gaps, achievement percentages and evaluation symbols are all derived
// at read time by lib/calc. The single exception is entry.computed_value, the
// cached result of a formula cell (see lib/formula).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrgUnitType {
  COMPANY
  DIVISION
  DEPARTMENT
}

enum UserRole {
  /// Everything, including locking a version, emptying a year, and any edit
  /// to a Ki that is neither current nor still being built.
  SUPER_ADMIN
  /// Directors and general managers. The company structure (Levels 1-3) and
  /// any unlocked figure, in the current Ki or a future one they are building.
  /// Never a locked version, never a past year, never the lock itself.
  EXECUTIVE
  /// A division or department lead: their own Level 4 branch and their own
  /// numbers, scoped to their org unit and anything beneath it.
  OWNER
  VIEWER
}

enum NodeKind {
  GOAL
  THEME
  OBJECTIVE
}

enum Unit {
  PERCENT
  CURRENCY
  COUNT
  RATIO
  DAYS
  INDEX
}

enum Direction {
  HIGHER_BETTER
  LOWER_BETTER
}

enum AchievementMethod {
  RATIO
  INVERSE
}

enum Aggregation {
  SUM
  AVERAGE
  LATEST
}

/// The fiscal year. Runs April 1 to March 31. "Ki 2026" = Apr 2026 -> Mar 2027.
model Ki {
  id        String   @id @default(cuid())
  code      String   @unique
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")

  planVersions PlanVersion[]
  nodes        Node[]

  @@map("ki")
}

model OrgUnit {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      OrgUnitType
  parentId  String?     @map("parent_id")
  sortOrder Int         @default(0) @map("sort_order")

  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgUnitTree")

  users           AppUser[]
  nodes           Node[]
  controlItemsDic ControlItem[] @relation("ControlItemDic")

  @@index([parentId])
  @@map("org_unit")
}

model AppUser {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  /// Null for a user who signs in through Microsoft only - an invitation
  /// that can be redeemed by SSO and by nothing else. The credentials
  /// provider compares against a dummy hash when this is absent, so a
  /// password attempt against an SSO account fails like any other.
  passwordHash  String?  @map("password_hash")
  /// The Entra `oid` claim: the durable, tenant-wide identifier for this
  /// person. An admin invites by email because that is what they know, but
  /// email is mutable in Entra and `oid` is not, so the first successful
  /// SSO sign-in records it here and every later sign-in prefers it. A
  /// rename or mailbox change then cannot orphan the account.
  entraObjectId String?  @unique @map("entra_object_id")
  role          UserRole @default(VIEWER)
  orgUnitId     String?  @map("org_unit_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  orgUnit OrgUnit? @relation(fields: [orgUnitId], references: [id])

  responsibleFor ControlItem[] @relation("ControlItemResponsible")
  entriesUpdated Entry[]       @relation("EntryUpdatedBy")
  auditEntries   EntryAudit[]  @relation("AuditChangedBy")
  reminders      ReminderLog[] @relation("ReminderRecipient")

  @@index([orgUnitId])
  @@map("app_user")
}

enum ReminderStatus {
  SENT
  FAILED
}

/// One reminder, to one person, for one month.
///
/// The unique constraint is the whole point: schedulers retry, someone re-runs
/// the job by hand, a deploy fires it twice. Nobody should be chased twice for
/// the same month because of that. It doubles as the record of what was sent
/// and to whom, which is the first thing asked when someone says they were
/// never told.
model ReminderLog {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  period           DateTime       @db.Date
  status           ReminderStatus
  /// How many Control Items were still missing when the reminder was built.
  outstandingCount Int            @map("outstanding_count")
  /// Why a send failed, kept so a failure can be retried deliberately.
  error            String?
  sentAt           DateTime       @default(now()) @map("sent_at")

  user AppUser @relation("ReminderRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([period])
  @@map("reminder_log")
}

/// A named snapshot of the plan for a Ki: OB, PRB, 1QFC, 2QFC, 3QFC, ACT.
model PlanVersion {
  id       String    @id @default(cuid())
  kiId     String    @map("ki_id")
  code     String
  label    String
  sequence Int
  isActual Boolean   @default(false) @map("is_actual")
  lockedAt DateTime? @map("locked_at")

  ki      Ki      @relation(fields: [kiId], references: [id], onDelete: Cascade)
  entries Entry[]

  @@unique([kiId, code])
  @@index([kiId, sequence])
  @@map("plan_version")
}

/// Self-referencing tree covering Levels 1-4. One table, not four: a fifth
/// level later needs no schema change.
model Node {
  id        String   @id @default(cuid())
  kiId      String   @map("ki_id")
  parentId  String?  @map("parent_id")
  level     Int
  kind      NodeKind
  statement String
  orgUnitId String?  @map("org_unit_id")
  sortOrder Int      @default(0) @map("sort_order")

  ki       Ki       @relation(fields: [kiId], references: [id], onDelete: Cascade)
  parent   Node?    @relation("NodeTree", fields: [parentId], references: [id])
  children Node[]   @relation("NodeTree")
  orgUnit  OrgUnit? @relation(fields: [orgUnitId], references: [id])

  controlItems ControlItem[]

  @@index([kiId, level])
  @@index([parentId])
  @@map("node")
}

/// The thing that actually gets measured - the measurement method.
/// One Control Item is one row on the report.
/// A business unit: Automobiles, Motorcycles, Power Products, Corporate.
///
/// Deliberately NOT a level in the OrgUnit tree. Divisions, departments and
/// people work across business units - Brand & Marketing serves all three
/// product lines - so a tree would force either a division per business unit
/// or a person into one they only half belong to. As its own dimension it
/// composes with the DIC instead of colliding with it: "motorcycle measures
/// owned by Aftersales" is the intersection of two independent tags, and the
/// org tree keeps its one job of saying who is accountable.
///
/// A row rather than an enum so a new business unit is data, not a deploy.
model BusinessUnit {
  id        String @id @default(cuid())
  code      String @unique
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  controlItems ControlItem[]

  @@map("business_unit")
}

model ControlItem {
  id                String            @id @default(cuid())
  nodeId            String            @map("node_id")
  code              String            @unique
  name              String
  /// How the target and actual are measured, in the reviewer's own words:
  /// "Units sold", "% of sales", "Engagement %". `unit` says how to format a
  /// figure; this says what the figure counts. Optional - the sheet falls back
  /// to a readable form of `unit` when it has not been filled in.
  ///
  /// Shown on every screen as "Control Item", which is the domain's own term
  /// for the measurement method. The stored name stays `measuredAs` because
  /// this table is already the ControlItem model, and a `controlItem` column on
  /// the control_item table would be unreadable in every query that touches it.
  measuredAs        String?           @map("measured_as")
  unit              Unit
  direction         Direction
  achievementMethod AchievementMethod @map("achievement_method")
  aggregation       Aggregation
  decimalPlaces     Int               @default(0) @map("decimal_places")
  dicOrgUnitId      String            @map("dic_org_unit_id")
  /// Which business unit this measure belongs to. Required: a measure that
  /// belongs to no business unit would be indistinguishable from one somebody
  /// forgot to tag, and the filter could not tell them apart. Genuinely
  /// measures shared across the units - engagement, group revenue, safety
  /// - carry SHARED.
  businessUnitId    String            @map("business_unit_id")
  responsibleUserId String?           @map("responsible_user_id")
  sortOrder         Int               @default(0) @map("sort_order")

  node            Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  dicOrgUnit      OrgUnit      @relation("ControlItemDic", fields: [dicOrgUnitId], references: [id])
  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id])
  responsibleUser AppUser? @relation("ControlItemResponsible", fields: [responsibleUserId], references: [id])

  entries      Entry[]
  dependencies EntryDependency[] @relation("DependencyTarget")

  @@index([nodeId])
  @@index([dicOrgUnitId])
  @@index([businessUnitId])
  @@index([responsibleUserId])
  @@map("control_item")
}

/// One cell: a Control Item x a month x a plan version. Targets and actuals
/// live in the same table - an actual is simply an entry on the ACT version.
model Entry {
  id            String   @id @default(cuid())
  controlItemId String   @map("control_item_id")
  period        DateTime @db.Date
  planVersionId String   @map("plan_version_id")
  rawValue      Decimal? @map("raw_value") @db.Decimal(20, 6)
  formula       String?
  computedValue Decimal? @map("computed_value") @db.Decimal(20, 6)
  errorCode     String?  @map("error_code")
  errorMessage  String?  @map("error_message")
  updatedById   String?  @map("updated_by")
  updatedAt     DateTime @updatedAt @map("updated_at")

  controlItem ControlItem @relation(fields: [controlItemId], references: [id], onDelete: Cascade)
  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  updatedBy   AppUser?    @relation("EntryUpdatedBy", fields: [updatedById], references: [id])

  audits       EntryAudit[]
  dependencies EntryDependency[] @relation("DependencyDependent")

  @@unique([controlItemId, period, planVersionId])
  @@index([planVersionId, period])
  @@index([controlItemId, planVersionId])
  @@map("entry")
}

/// Append-only. Never updated, never deleted.
model EntryAudit {
  id          String   @id @default(cuid())
  entryId     String   @map("entry_id")
  oldValue    Decimal? @map("old_value") @db.Decimal(20, 6)
  newValue    Decimal? @map("new_value") @db.Decimal(20, 6)
  oldFormula  String?  @map("old_formula")
  newFormula  String?  @map("new_formula")
  changedById String?  @map("changed_by")
  changedAt   DateTime @default(now()) @map("changed_at")

  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  changedBy AppUser? @relation("AuditChangedBy", fields: [changedById], references: [id])

  @@index([entryId, changedAt])
  @@map("entry_audit")
}

/// Edges of the formula dependency graph: `dependentEntry` reads the cell
/// addressed by (targetControlItem, targetPeriod, targetPlanVersion).
model EntryDependency {
  id                  String   @id @default(cuid())
  dependentEntryId    String   @map("dependent_entry_id")
  targetControlItemId String   @map("target_control_item_id")
  targetPeriod        DateTime @map("target_period") @db.Date
  targetPlanVersionId String   @map("target_plan_version_id")

  dependentEntry    Entry       @relation("DependencyDependent", fields: [dependentEntryId], references: [id], onDelete: Cascade)
  targetControlItem ControlItem @relation("DependencyTarget", fields: [targetControlItemId], references: [id], onDelete: Cascade)

  @@unique([dependentEntryId, targetControlItemId, targetPeriod, targetPlanVersionId])
  @@index([targetControlItemId, targetPeriod, targetPlanVersionId])
  @@map("entry_dependency")
}

/// Admin editable. Validated on startup: contiguous, covering the full number
/// line, boundaries belonging to the upper band.
model EvaluationBand {
  id        String   @id @default(cuid())
  symbol    String   @unique
  label     String
  minPct    Decimal? @map("min_pct") @db.Decimal(10, 4)
  maxPct    Decimal? @map("max_pct") @db.Decimal(10, 4)
  colorHex  String   @map("color_hex")
  sortOrder Int      @default(0) @map("sort_order")

  @@map("evaluation_band")
}
