{
  "name": "hoshin-kanri",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run lib",
    "test:watch": "vitest",
    "check:symbols": "node scripts/check-symbols.cjs",
    "db:migrate": "prisma migrate dev",
