    "db:studio": "prisma studio",
    "backup": "./scripts/backup.sh",
    "check:acceptance": "tsx scripts/accept-check.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-virtual": "^3.14.10",
